{
  "name": "tolgee-mcp-server",
  "version": "1.0.2",
  "description": "MCP server for Tolgee translation management",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "axios": "1.15.2",
    "express": "4.22.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "24.12.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "hono": "4.12.15",
    "ajv": "8.20.0",
    "express-rate-limit": "8.4.1",
    "follow-redirects": "1.16.0",
    "path-to-regexp": "8.4.2",
    "qs": "6.15.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
